{
  "info": {
    "name": "Chat App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runs against the dev:memory server. Creates its own users on every run."
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status flag\", () => pm.expect(pm.response.json().status).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Register user A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = Date.now().toString(36);",
              "pm.collectionVariables.set(\"userA\", \"pm_a_\" + s);",
              "pm.collectionVariables.set(\"userB\", \"pm_b_\" + s);",
              "pm.collectionVariables.set(\"userC\", \"pm_c_\" + s);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"returns token and user\", () => { pm.expect(body.token).to.be.a(\"string\"); pm.expect(body.user.username).to.eql(pm.collectionVariables.get(\"userA\")); });",
              "pm.test(\"password is never returned\", () => pm.expect(pm.response.text()).to.not.match(/password/i));",
              "pm.collectionVariables.set(\"tokenA\", body.token);",
              "pm.collectionVariables.set(\"idA\", body.user._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userA}}\",\n  \"email\": \"{{userA}}@example.test\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
