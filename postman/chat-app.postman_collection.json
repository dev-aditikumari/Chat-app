    {
      "name": "List users (excludes self)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "const users = pm.response.json();",
              "pm.test(\"does not include me\", () => pm.expect(users.map(u => u._id)).to.not.include(pm.collectionVariables.get(\"idA\")));",
              "pm.test(\"includes user B\", () => pm.expect(users.map(u => u._id)).to.include(pm.collectionVariables.get(\"idB\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
