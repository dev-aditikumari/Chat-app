    {
      "name": "Send message A to B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"saved with sender from token\", () => { const m = pm.response.json().message; pm.expect(m.from).to.eql(pm.collectionVariables.get(\"idA\")); pm.expect(m.text).to.eql(\"hello from postman\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
