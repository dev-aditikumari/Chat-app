    {
      "name": "Conversation as B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"B sees A's message\", () => { const msgs = pm.response.json().messages; pm.expect(msgs).to.have.length(1); pm.expect(msgs[0].text).to.eql(\"hello from postman\"); });"
